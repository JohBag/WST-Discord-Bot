{
    "type": "module",
    "name": "wst",
    "version": "1.0.0",
    "description": "",
    "main": "dist/bot.js",
    "author": "deacon",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
        "build": "npm run clean && tsc",
        "start": "node --env-file=.env dist/bot.js",
        "deploy-commands": "node --env-file=.env dist/deploy-commands.js",
        "delete-commands": "node --env-file=.env dist/delete-commands.js",
        "test": "npm run build && node --test dist/tests/*.test.js",
        "vm": "node scripts/vm.mjs",
        "deploy": "node scripts/vm.mjs deploy",
        "logs": "node scripts/vm.mjs logs"
    },
    "dependencies": {
        "@google/genai": "^1.30.0",
        "discord.js": "^14.25.1"
    },
    "devDependencies": {
        "@types/node": "^25.5.2",
        "typescript": "^6.0.2"
    }
}
