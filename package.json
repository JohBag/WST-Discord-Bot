{
    "type": "module",
    "name": "wst",
    "version": "1.0.0",
    "description": "",
    "main": "dist/bot.js",
    "author": "deacon",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
        "build": "npm run clean && tsc",
        "start": "node --env-file=.env dist/bot.js",
        "deploy-commands": "node --env-file=.env dist/deploy-commands.js",
        "delete-commands": "node --env-file=.env dist/delete-commands.js",
        "test": "npm run build && node --test \"dist/**/*.test.js\"",
        "compare": "tsc && node --env-file=.env dist/tools/compare.js",
        "vm": "node scripts/vm.mjs",
        "deploy": "node scripts/vm.mjs deploy",
        "logs": "node scripts/vm.mjs logs"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.131.0",
        "@discordjs/voice": "^0.19.2",
        "@google/genai": "^1.52.0",
        "discord.js": "^14.25.1",
        "ffmpeg-static": "^5.3.0"
    },
    "devDependencies": {
        "@types/node": "^25.5.2",
        "typescript": "^6.0.2"
    }
}
